%ignore " "

program     : "(" PROGRAM "(" parameters ")" term ")"
parameters  : IDENTIFIER*

term        : let
            | letrec
            | reference
            | abstract
            | apply
            | immediate
            | boolean
            | primitive
            | if
            | allocate
            | load
            | store
            | begin
            | vector
            | vector_ref
            | vector_set
            | match
            | def_data


let         : "(" LET "(" bindings ")" term ")"

letrec      : "(" LETREC "(" bindings ")" term ")"

reference   : IDENTIFIER

abstract    : "(" LAMBDA "(" parameters ")" term ")"

apply       : "(" term term* ")"

immediate   : IMMEDIATE

boolean     : BOOLEAN

primitive   : "(" OPERATOR term term ")"

// branch      : "(" BRANCH  "(" COMPARE term term ")" term term ")"
// if replaces branch :)
if          : "(" IF "(" BOOLEAN ")" term term ")"

allocate    : "(" ALLOCATE IMMEDIATE ")"

load        : "(" LOAD term IMMEDIATE ")"

store       : "(" STORE term IMMEDIATE term ")"

begin       : "(" BEGIN term+ ")"

vector      : "(" "vector" term+ ")"

vector_ref  : "(" "vector-ref" term IMMEDIATE ")"

vector_set  : "(" "vector-set" term IMMEDIATE term ")"

match       : "(" MATCH term case+ ")"

case        : "(" pattern term ")"

// Oh he's supposed to be here
pattern     : pattern_variable
            | pattern_wildcard
            | pattern_immediate
            | pattern_vector

pattern_variable  : IDENTIFIER

pattern_wildcard  : "_"

pattern_immediate : IMMEDIATE

pattern_vector    : "(" "vector" pattern* ")"

def_data          : "(" "def-data" IDENTIFIER data+ ")"

data              : "(" IDENTIFIER bindings ")"

bindings    : binding*
binding     : "(" IDENTIFIER term ")"

OPERATOR    : "+" | "-" | "*"
COMPARE     : ">" | "<" | "=="

PROGRAM.2   : "l3"
LET.2       : "let"
LETREC.2    : "letrec"
BRANCH.2    : "if"
ALLOCATE.2  : "allocate"
LOAD.2      : "load"
STORE.2     : "store"
BEGIN.2     : "begin"
LAMBDA.2    : "\\" | "lambda" | "λ"
VECTOR.2    : "vector"
VECTOR_REF.2: "vector-ref"
VECTOR_SET.2: "vector-set!"
MATCH.2     : "match"

IDENTIFIER  : /[a-zA-Z_][a-zA-Z0-9_]*/
IMMEDIATE   : /-?\d+/
BOOLEAN     : "True" | "False"